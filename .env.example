# TrendRadar API — örnek ortam dosyası
# Kullanım: bu dosyayı `.env` adıyla kopyalayın ve gerekli değerleri değiştirin.
# `.env` dosyası git'e girmez. Buradaki değerler varsayılanlarla aynıdır.

# --- Uygulama ---
# Swagger başlığında ve /health yanıtında görünen ad
APP_NAME="TrendRadar API"

# Çalışma modu: "mock" (sahte veri, cookie gerekmez) veya "live" (gerçek Google Trends)
TRENDS_MODE=mock

# --- Parola koruması ---
# İkisi de doluysa API, Swagger ve web arayüzü kullanıcı adı + parola ister (HTTP Basic Auth);
# yalnızca /health açık kalır. İkisi de boşsa koruma kapalıdır (yerel geliştirme).
# Uygulamayı herkese açık bir adreste yayınlıyorsanız mutlaka doldurun ve güçlü bir parola seçin.
AUTH_USERNAME=
AUTH_PASSWORD=

# --- Veritabanı ---
# Yerel geliştirme: SQLite dosyası
# Docker: postgresql+psycopg://trendradar:trendradar@db:5432/trendradar
DATABASE_URL=sqlite:///./trendradar.db

# --- Google Trends (yalnızca live modda kullanılır) ---
# Google hesap oturumunu içeren cookie dosyası. ASLA commit etmeyin veya paylaşmayın.
COOKIE_FILE=cookies.json

# Arayüz dili. Not: en-US ile bazı keyword'ler boş dönüyor
HL=tr-TR

# Saat dilimi farkı (dakika, Google JS konvansiyonu: UTC+3 için -180)
TZ_OFFSET=-180

# --- Tarama varsayılanları ---
# Ülke kodu (2 harf). Boş = tüm dünya
DEFAULT_GEO=

# Zaman aralığı: "now 7-d", "today 1-m", "today 3-m", "today 12-m", "today 5-y"
DEFAULT_TIMEFRAME="today 1-m"

# --- Hız sınırlama ve yeniden deneme (live mod) ---
# Keyword'ler arası rastgele bekleme aralığı (saniye)
SLEEP_MIN=5
SLEEP_MAX=12

# Başarısız istek için en fazla deneme sayısı
MAX_RETRIES=3

# Üstel geri çekilme tabanı (saniye): 30, 60, 120
BACKOFF_BASE=30

# Tek bir HTTP isteğinin zaman aşımı (saniye)
REQUEST_TIMEOUT=30

# --- Analiz ---
# Rising değeri bu eşik ve üzerindeyse "breakout" sayılır
BREAKOUT_THRESHOLD=5000

# --- İstek sınırları ---
# Tek bir taramadaki en fazla keyword sayısı
MAX_KEYWORDS_PER_JOB=30

# Bir keyword'ün en fazla karakter uzunluğu
MAX_KEYWORD_LENGTH=100

# Listeleme endpoint'lerinde varsayılan ve en fazla sayfa boyutu
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# --- Mock mod ---
# Mock modda keyword başına bekleme (saniye). Testlerde 0 kullanılır
MOCK_DELAY_SECONDS=0.5
